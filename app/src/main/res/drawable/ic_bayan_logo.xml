                android:angle="135"
                android:startX="549"
                android:startY="82"
                android:endX="601"
                android:endY="134"
                android:type="linear">
                <item android:offset="0.0" android:color="#FDBA74" />
                <item android:offset="0.4" android:color="#F97316" />
                <item android:offset="1.0" android:color="#EA580C" />
            </gradient>
        </aapt:attr>
