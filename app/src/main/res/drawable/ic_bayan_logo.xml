                android:startX="595"
                android:startY="375"
                android:endX="635"
                android:endY="335"
                android:type="linear">
                <item android:offset="0.0" android:color="#005B82" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>


    <!-- ======================================================== -->
    <!-- 3. RIGHT: LETTER "ب" (BAA) WITH WARM ORANGE GRADIENT    -->
    <!-- ======================================================== -->

