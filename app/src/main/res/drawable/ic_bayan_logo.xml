        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="90"
                android:startX="515"
                android:startY="375"
                android:endX="555"
                android:endY="335"
                android:type="linear">
                <item android:offset="0.0" android:color="#005B82" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
