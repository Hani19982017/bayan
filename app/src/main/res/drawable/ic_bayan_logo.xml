    <!-- Orange Ribbon Sweep of "ب" -->
    <path
        android:pathData="M 575,142 C 550,142 522,165 514,198 C 504,235 530,265 565,265 C 588,265 608,248 616,225 C 620,214 626,217 624,227 C 615,268 578,305 528,310 C 495,313 470,302 452,288 L 464,268 C 480,280 500,288 524,286 C 560,282 588,252 590,215 C 582,220 570,225 555,225 C 528,225 504,202 508,174 C 512,148 538,124 575,124 C 586,124 597,128 604,135 C 610,140 614,134 610,128 C 600,118 586,112 575,112 Z">
        <aapt:attr name="android:fillColor">
