                android:startX="354"
                android:startY="326"
                android:endX="403"
                android:endY="92"
                android:type="linear">
                <item android:offset="0.0" android:color="#005B82" />
                <item android:offset="0.5" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#0099DD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Slanted Fathah Accent (ـَ) -->
    <path
        android:pathData="M 412,202 L 492,150 C 496,147 500,150 498,154 L 490,160 C 488,162 418,208 414,208 C 410,208 408,204 412,202 Z"
        android:fillColor="#0284C7" />

