        </aapt:attr>
    </path>


    <!-- ======================================================== -->
    <!-- 2. MIDDLE: TALL ALIF ("ا") & ACCENTS                    -->
    <!-- ======================================================== -->

    <!-- Tall Alif Stem -->
    <path
        android:pathData="M 365,102 C 365,96 372,92 378,96 L 396,108 C 400,111 403,116 402,122 L 390,265 C 388,285 405,298 428,300 C 455,302 485,292 510,274 L 512,295 C 478,318 435,326 398,320 C 365,315 352,290 354,258 L 365,102 Z">
